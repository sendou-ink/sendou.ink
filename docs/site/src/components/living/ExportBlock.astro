---
import { Badge } from "@astrojs/starlight/components";
import { highlight } from "../../../../../scripts/living-docs/highlight.ts";
import { exportAnchor } from "../../../../../scripts/living-docs/links.ts";
import type {
	ExportDoc,
	ModuleDoc,
} from "../../../../../scripts/living-docs/modules.ts";
import type { RepositoryExportDoc } from "../../../../../scripts/living-docs/repositories.ts";
import {
	featureOf,
	markdown,
	repositoryHref,
	repositoryLabel,
	usageChips,
	viewHref,
} from "../../living/format.ts";
import FileLink from "./FileLink.astro";
import TableChips from "./TableChips.astro";
import UnitTests from "./UnitTests.astro";

interface Props {
	exported: ExportDoc | RepositoryExportDoc;
	module: Pick<ModuleDoc, "name" | "path">;
}

const { exported, module } = Astro.props;
const dataAccess =
	"tables" in exported &&
	(exported.tables.length > 0 ||
		exported.calls.length > 0 ||
		exported.permissions.length > 0)
		? exported
		: null;
---

<div class="export">
	<div class="export-head">
		<span class={`kind kind-${exported.kind}`}>{exported.kind}</span>
		<h3 class="export-name" id={exportAnchor(module.name, exported)}>
			<code>{exported.name}</code>
		</h3>
		{
			exported.doc ? null : (
				<Badge text="no JSDoc" title="Module functions should always have JSDoc" variant="caution" size="small" />
			)
		}
		<FileLink file={module.path} line={exported.line} label={`:${exported.line}`} />
	</div>
	{
		exported.doc?.description ? (
			<div class="doc" set:html={markdown(exported.doc.description)} />
		) : null
	}
	{
		exported.doc && exported.doc.tags.length > 0 ? (
			<ul class="doc-tags">
				{exported.doc.tags.map((tag) => (
					<li>
						<span>@{tag.tag}</span> <Fragment set:html={markdown(tag.text)} />
					</li>
				))}
			</ul>
		) : null
	}
	<pre class="code scrollbar" set:html={highlight(exported.signature)} />
	{
		dataAccess ? (
			<div class="usages">
				{dataAccess.tables.length > 0 ? (
					<div class="usage-row">
						<span class="usage-kind">Tables</span>
						<span>
							<TableChips tables={dataAccess.tables} />
						</span>
					</div>
				) : null}
				{dataAccess.permissions.length > 0 ? (
					<div class="usage-row">
						<span class="usage-kind">Permissions</span>
						<span>
							{dataAccess.permissions.map((name) => (
								<a class="chip" href={viewHref(featureOf(module.path), "permissions", "granted")}>
									{name}
								</a>
							))}
						</span>
					</div>
				) : null}
				{dataAccess.calls.length > 0 ? (
					<div class="usage-row">
						<span class="usage-kind">Calls</span>
						<span>
							{dataAccess.calls.map((call) => (
								<a class="chip file-chip" href={repositoryHref(call.repository, call.name)}>
									{repositoryLabel(call.repository)}.{call.name}
								</a>
							))}
						</span>
					</div>
				) : null}
			</div>
		) : null
	}
	{exported.unitTests.length > 0 ? <UnitTests tests={exported.unitTests} /> : null}
	<div class="usages">
		{
			exported.usages.length > 0 ? (
				exported.usages.map((group) => (
					<div class="usage-row">
						<span class={`usage-kind kind-${group.kind}`}>{group.label}</span>
						<span class="usage-files">
							{usageChips(group).map((chip) => (
								<FileLink
									file={chip.file}
									line={chip.line}
									label={chip.label}
									class="chip file-chip"
								/>
							))}
						</span>
					</div>
				))
			) : (
				<span class="muted">Only used inside the module</span>
			)
		}
	</div>
</div>
