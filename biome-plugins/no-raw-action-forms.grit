language js

// Fixed-field mutations (an `_action` plus hidden inputs) go through
// `<ActionButton>` (app/components/ActionButton.tsx). Real multi-input forms
// keep their own form but pass `schema` alongside `_action` to `SubmitButton`
// so the action literal is type checked against the route's zod action schema.
or {
	JsxAttribute(name=`_action`) as $attr where {
		$attr <: not within or {
			JsxOpeningElement(attributes=contains JsxAttribute(name=`schema`)),
			JsxSelfClosingElement(attributes=contains JsxAttribute(name=`schema`))
		} ,
		register_diagnostic(span=$attr, message="Untyped `_action`. For a fixed-field mutation use `<ActionButton schema={...} action=\"...\" fields={{...}}>`; for a submit button of a real multi-input form pass `schema={...}` alongside `_action` so the literal is type checked against the route's schema.", severity="error")
	},
	`name="_action"` as $attr where {
		register_diagnostic(span=$attr, message="Do not submit `_action` via a hidden input or button name. Use `<ActionButton schema={...} action=\"...\" fields={{...}}>`, or a `SubmitButton` with `schema` and `_action` inside a real multi-input form. If neither fits, suppress with `// biome-ignore lint/plugin: <reason>`.", severity="error")
	}
}
