{
	"name": "sendou.ink",
	"version": "3.0.0",
	"private": true,
	"packageManager": "pnpm@11.0.9",
	"type": "module",
	"scripts": {
		"deploy": "pnpm install --frozen-lockfile && pnpm --filter web-react run build",
		"build": "pnpm --filter web-react run build",
		"dev": "pnpm --filter web-react run dev",
		"dev:fast": "pnpm --filter web-react run dev:fast",
		"dev:prod": "pnpm --filter web-react run dev:prod",
		"start": "pnpm --filter web-react run start",
		"migrate": "pnpm --filter web-react run migrate",
		"migrate:new": "pnpm --filter web-react run migrate:new",
		"migrate:prod": "pnpm --filter web-react run migrate:prod",
		"seed": "pnpm --filter web-react run seed",
		"setup": "pnpm --filter web-react run setup",
		"biome:check": "biome check --error-on-warnings .",
		"biome:fix": "biome check --error-on-warnings --write .",
		"biome:fix:unsafe": "biome check --error-on-warnings --write --unsafe .",
		"typecheck": "pnpm --filter web-react run typecheck",
		"typecheck:scripts": "pnpm --filter web-react run typecheck:scripts",
		"test:unit:browser": "pnpm --filter web-react run test:unit:browser",
		"test:scanner": "pnpm --filter web-react run test:scanner",
		"test:e2e": "pnpm --filter web-react run test:e2e",
		"test:e2e:flaky-detect": "pnpm --filter web-react run test:e2e:flaky-detect",
		"check-translation-jsons": "pnpm --filter web-react run check-translation-jsons",
		"check-translation-jsons:no-write": "pnpm --filter web-react run check-translation-jsons:no-write",
		"check-plural-collapse": "pnpm --filter web-react run check-plural-collapse",
		"check-articles": "pnpm --filter web-react run check-articles",
		"i18n:sync": "pnpm --filter web-react run i18n:sync",
		"knip": "pnpm --filter web-react run knip",
		"checks": "pnpm --filter web-react run checks",
		"manifest:report": "pnpm --filter @sendou-ink/codemods run manifest:report"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7"
	}
}
