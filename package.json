{
	"name": "sendou.ink",
	"version": "3.0.0",
	"private": true,
	"packageManager": "bun@1.4.3",
	"sideEffects": false,
	"type": "module",
	"scripts": {
		"deploy": "bun install --frozen-lockfile && bun run build",
		"build": "bun run i18n:usage && bun --bun react-router build",
		"dev": "DB_PATH=db.sqlite3 bun run migrate up && bun run setup && bun run i18n:usage && bun --bun react-router dev --host",
		"dev:fast": "bun --bun react-router dev --host",
		"dev:docs": "astro dev --root docs/site",
		"dev:tools": "bun scripts/dev-tools.ts",
		"dev:sandbox": "DB_PATH=db-sandbox.sqlite3 VITE_PROD_MODE=true bun --bun react-router dev --host",
		"start": "bun run migrate up && NODE_ENV=production bun --no-env-file server.ts",
		"migrate": "bun scripts/migrate.ts",
		"migrate:new": "bun scripts/create-migration.ts",
		"migrate:sandbox": "DB_PATH=db-sandbox.sqlite3 bun run migrate up",
		"check-translation-jsons": "bun scripts/check-translation-jsons.ts",
		"check-translation-jsons:no-write": "bun scripts/check-translation-jsons.ts --no-write",
		"check-articles": "bun scripts/check-articles.ts",
		"bench:db": "DB_PATH=db-sandbox.sqlite3 VITE_PROD_MODE=true bun --preload ./scripts/preload.ts ./scripts/benchmark-db.ts",
		"compute-luti-divs": "bun --preload ./scripts/preload.ts ./scripts/compute-luti-divs.ts",
		"vods:download": "DB_PATH=db-sandbox.sqlite3 VITE_PROD_MODE=true bun --preload ./scripts/preload.ts ./scripts/download-tournament-vods.ts",
		"download-prod-db": "bun scripts/download-prod-db.ts",
		"deploy:prod": "bun scripts/deploy-prod.ts",
		"sandbox:reset": "bun scripts/reset-sandbox-db.ts && bun run migrate:sandbox",
		"biome:check": "biome check --error-on-warnings .",
		"biome:fix": "biome check --error-on-warnings --write .",
		"biome:fix:unsafe": "biome check --error-on-warnings --write --unsafe .",
		"typecheck": "react-router typegen && bun run typecheck:app",
		"typecheck:app": "bun check",
		"typecheck:scripts": "bun check -p scripts",
		"typecheck:docs": "astro sync --root docs/site && bun check -p docs/site",
		"test:unit": "bun scripts/ensure-test-db.ts && bun run test:unit:run",
		"test:unit:run": "bun --no-env-file test --parallel --only-failures",
		"test:dom": "bun --no-env-file test --parallel --only-failures --preload ./app/dom-test-setup.ts --path-ignore-patterns='e2e/**' .dom.test",
		"test:unit:dom": "bun run test:unit && bun run test:dom",
		"test:scanner": "bun --no-env-file test --parallel --only-failures --timeout=120000 --path-ignore-patterns='app/features/scanner/tests/logic/**' app/features/scanner/tests/",
		"scanner:report": "bun --preload ./scripts/preload.ts scripts/scanner/report.ts",
		"scanner:scan-vod": "bun --preload ./scripts/preload.ts scripts/scanner/scan-vod.ts",
		"scanner:status-audit": "bun --preload ./scripts/preload.ts scripts/scanner/status-audit.ts",
		"scanner:gpu-parity": "bun --preload ./scripts/preload.ts scripts/scanner/gpu-parity.ts",
		"scanner:gpu-replay": "bun --preload ./scripts/preload.ts scripts/scanner/gpu-replay.ts",
		"scanner:fixtures": "bun --preload ./scripts/preload.ts scripts/scanner/run-fixtures.ts",
		"scanner:unpack-zip": "bun scripts/scanner/unpack-game-data-zip.ts",
		"scanner:replay": "bun --preload ./scripts/preload.ts scripts/scanner/replay-frames.ts",
		"scanner:bootstrap-atlas": "bun --preload ./scripts/preload.ts scripts/scanner/bootstrap-atlas-from-fixture.ts",
		"scanner:build-glyph-atlas": "bun --preload ./scripts/preload.ts scripts/scanner/build-glyph-atlas.ts",
		"scanner:build-localized-entries": "bun --preload ./scripts/preload.ts scripts/scanner/build-localized-entries.ts",
		"scanner:build-planner-signatures": "bun --preload ./scripts/preload.ts scripts/scanner/build-planner-signatures.ts",
		"test:e2e": "playwright test",
		"test:e2e:flaky-detect": "playwright test --repeat-each=10 --max-failures=1",
		"check-plural-collapse": "bun scripts/collapse-single-plural-keys.ts --check",
		"check-translation-sync": "bun scripts/sync-translation-jsons.ts --check",
		"checks": "bun run biome:fix && react-router typegen && bun scripts/ensure-test-db.ts && bun run --parallel --no-exit-on-error test:unit:run test:dom check-translation-jsons check-plural-collapse check-translation-sync typecheck:app typecheck:scripts typecheck:docs knip",
		"checks:scanner": "bun run checks && bun run test:scanner",
		"seed": "DB_PATH=db.sqlite3 bun --preload ./scripts/preload.ts ./scripts/seed.ts",
		"setup": "DB_PATH=db.sqlite3 bun --preload ./scripts/preload.ts ./scripts/setup.ts",
		"og:generate": "bun scripts/generate-og-images.ts",
		"changelog:image": "bun scripts/generate-changelog-image.ts",
		"docs:build": "astro build --root docs/site && bun scripts/check-docs-links.ts",
		"docs:preview": "astro build --root docs/site && astro preview --root docs/site",
		"docs:capture": "bun scripts/living-docs/capture.ts",
		"docs:screenshots:publish": "bun scripts/living-docs/published-screenshots.ts publish",
		"docs:screenshots:download": "bun scripts/living-docs/published-screenshots.ts download",
		"notification:test": "DB_PATH=db.sqlite3 bun --preload ./scripts/preload.ts ./scripts/send-test-notification.ts",
		"i18n:usage": "bun scripts/generate-translation-usage.ts",
		"i18n:sync": "bun scripts/collapse-single-plural-keys.ts && bun scripts/sync-translation-jsons.ts && bun run biome:fix",
		"knip": "knip"
	},
	"dependencies": {
		"@daily-co/daily-js": "0.94.0",
		"@daily-co/daily-react": "0.26.1",
		"@date-fns/tz": "1.5.0",
		"@dnd-kit/core": "6.3.1",
		"@dnd-kit/modifiers": "9.0.0",
		"@dnd-kit/sortable": "10.0.0",
		"@dnd-kit/utilities": "3.2.2",
		"@epic-web/cachified": "5.6.3",
		"@techstark/opencv-js": "5.0.0-release.1",
		"@tldraw/tldraw": "3.12.1",
		"@zumer/snapdom": "3.3.5",
		"clsx": "2.1.1",
		"compressorjs": "1.4.0",
		"date-fns": "4.4.0",
		"edmonds-blossom-fixed": "1.0.1",
		"fflate": "0.8.3",
		"i18next": "26.3.6",
		"ics": "3.12.1",
		"isbot": "5.2.2",
		"kysely": "0.29.0",
		"lucide-react": "1.59.0",
		"mediabunny": "1.61.6",
		"nanoid": "6.0.2",
		"nprogress": "0.2.0",
		"openskill": "5.0.1",
		"picocad2-web": "2.0.4",
		"qrcode.react": "4.2.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-error-boundary": "6.1.6",
		"react-i18next": "17.0.11",
		"react-router": "8.4.0",
		"remeda": "2.52.0",
		"remix-auth": "4.2.0",
		"remix-auth-oauth2": "3.4.1",
		"slugify": "1.6.9",
		"swr": "2.5.1",
		"valibot": "^1.5.0",
		"web-haptics": "0.0.6"
	},
	"devDependencies": {
		"@astrojs/markdown-satteri": "0.4.5",
		"@astrojs/react": "7.1.1",
		"@astrojs/starlight": "0.42.6",
		"@babel/preset-typescript": "7.29.7",
		"@biomejs/biome": "2.5.15",
		"@faker-js/faker": "10.6.0",
		"@happy-dom/global-registrator": "21.0.3",
		"@napi-rs/canvas": "1.0.11",
		"@playwright/test": "1.64.1",
		"@react-router/dev": "8.4.0",
		"@testing-library/dom": "10.4.2",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.8",
		"@types/bun": "1.4.3",
		"@types/nprogress": "0.2.3",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"astro": "7.4.2",
		"babel-plugin-react-compiler": "19.1.0-rc.3",
		"knip": "6.42.0",
		"magic-string": "1.4.3",
		"mermaid": "12.2.0",
		"oxc-parser": "0.154.0",
		"oxc-transform-react": "0.154.0",
		"postcss": "8.5.31",
		"sql-formatter": "15.9.0",
		"vite": "8.3.4",
		"vite-plugin-babel": "1.7.3"
	},
	"patchedDependencies": {
		"@techstark/opencv-js@5.0.0-release.1": "patches/@techstark__opencv-js@5.0.0-release.1.patch",
		"i18next@26.3.6": "patches/i18next@26.3.6.patch",
		"kysely@0.29.0": "patches/kysely@0.29.0.patch",
		"react-i18next@17.0.11": "patches/react-i18next@17.0.11.patch",
		"react-router@8.4.0": "patches/react-router@8.4.0.patch",
		"@react-router/dev@8.4.0": "patches/@react-router%2Fdev@8.4.0.patch"
	}
}
