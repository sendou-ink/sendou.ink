{
	"name": "@sendou/web-svelte",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "pnpm run i18n:combine && cross-env DB_PATH=../db.sqlite3 node --env-file-if-exists=../.env ./node_modules/vite/bin/vite.js dev --port 5174",
		"build": "pnpm run i18n:combine && node scripts/build.ts",
		"start": "node build/index.js",
		"i18n:combine": "node scripts/combine-locales.ts",
		"check": "pnpm run i18n:combine && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test:e2e": "playwright test",
		"measure:bundle": "node scripts/measure-bundle.ts",
		"measure:ssr": "node scripts/measure-ssr.ts"
	},
	"dependencies": {
		"@lucide/svelte": "1.65.0",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "3.2.2",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-node": "6.0.2",
		"@sveltejs/kit": "3.2.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"cross-env": "10.1.0",
		"svelte": "5.57.3",
		"svelte-check": "^4.7.6",
		"typescript": "~6.0.3",
		"vite": "8.3.5"
	}
}
